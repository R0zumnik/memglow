{
  "title": "My assistant's memory",
  "memoryDir": "./memory",
  "port": 4747,
  "indexNote": ["MEMORY", "index"],
  "themes": [
    { "id": "people", "label": "People", "color": "#2EE89B" },
    { "id": "projects", "label": "Projects", "color": "#8FA8FF" },
    { "id": "knowledge", "label": "Knowledge", "color": "#4FD1E0" },
    { "id": "habits", "label": "Habits & rules", "color": "#FFB86B" },
    { "id": "archive", "label": "Archive", "color": "#7E948D" }
  ],
  "themeByFolder": [
    ["user", "people"],
    ["project", "projects"],
    ["reference", "knowledge"],
    ["feedback", "habits"],
    ["project/archive", "archive"]
  ],
  "defaultTheme": "knowledge",
  "subthemeLabels": { "home-lab": "Home lab", "client-work": "Client work" },
  "showBodies": true,
  "largeNoteTokens": 5000,
  "splitChunkTokens": 2000,
  "protectedThemes": ["people", "habits"],
  "alwaysLoaded": ["~/.claude/CLAUDE.md", "./CLAUDE.md", "AGENTS.md"],
  "sessionsPerDay": 5,
  "indexWarningTokens": 2000,
  "proxy": { "sizeWarning": true, "indexWarning": false, "searchDetails": true, "suggestions": true, "dedupe": false, "toc": false, "archiveHint": false },
  "archiveAfterDays": 105,
  "archive": { "folder": "archive", "summaryNote": "archive-summary", "maxSuggestions": 20, "minSectionTokens": 100 },
  "pollMs": 2000,
  "clients": ["claude-code", "codex"],
  "trustProxy": false,
  "assistant": {
    "enabled": false,
    "provider": "claude-code",
    "timeoutMinutes": 10,
    "backup": "auto",
    "claude-code": { "model": "sonnet", "maxBudgetUsd": 0.5 },
    "anthropic": { "model": "claude-sonnet-5-5", "maxTokens": 32000, "timeoutMinutes": 5, "confirmRemote": true },
    "openai-compatible": { "preset": "mistral", "model": "mistral-large-latest", "temperature": 0.2 },
    "ollama": { "model": "llama3.1" }
  }
}

{
  "name": "memglow",
  "version": "0.4.0",
  "description": "A live 3D view of your AI assistant's Markdown memory — watch notes light up as Claude, Codex, Gemini, Cursor, Copilot and others read, search and write them.",
  "license": "MIT",
  "main": "server.js",
  "bin": {
    "memglow": "bin/memglow.js",
    "memglow-mcp-proxy": "mcp-proxy/memglow-mcp-proxy.js",
    "memglow-mcp": "mcp-server/memglow-mcp.js"
  },
  "files": [
    "server.js",
    "bin/",
    "lib/",
    "public/",
    "hooks/",
    "adapters/",
    "mcp-proxy/",
    "mcp-server/",
    "docker-compose.example.yml",
    "memglow.config.example.json",
    "THIRD_PARTY_LICENSES",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/memglow.js",
    "demo": "MEMORY_DIR=./demo/memory node server.js",
    "simulate": "node demo/simulate.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "memory",
    "mcp",
    "basic-memory",
    "obsidian",
    "markdown",
    "knowledge-graph",
    "visualization",
    "3d",
    "codex",
    "gemini-cli",
    "cursor",
    "copilot",
    "windsurf",
    "cline",
    "hooks",
    "mcp-proxy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/R0zumnik/memglow.git"
  },
  "homepage": "https://r0zumnik.github.io/memglow/",
  "bugs": {
    "url": "https://github.com/R0zumnik/memglow/issues"
  }
}

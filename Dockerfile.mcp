# memglow MCP server — read-only, stdio only (no HTTP, no viewer). Separate from the main
# Dockerfile (which runs the web viewer, server.js): this one only starts mcp-server/memglow-mcp.js,
# for MCP clients and directories (e.g. Glama) that run an MCP server from a container.
#
#   docker build -f Dockerfile.mcp -t memglow-mcp .
#   docker run -i --rm -v /path/to/notes:/memory:ro memglow-mcp
#
# stdio only: always run with -i (interactive), never -d. No port is exposed — there is nothing to
# expose, this is not a network service.
FROM node:22-alpine
WORKDIR /app
COPY package.json THIRD_PARTY_LICENSES LICENSE ./
COPY lib ./lib
COPY mcp-server ./mcp-server
ENV NODE_ENV=production \
    MEMORY_DIR=/memory \
    MEMGLOW_DATA_DIR=/data
# Read-only access to the notes is enough: this server never writes to MEMORY_DIR, or to anything
# else — not even its own counters (it only reads them, from /data, if that volume is provided).
VOLUME /data
USER node
CMD ["node", "mcp-server/memglow-mcp.js"]
